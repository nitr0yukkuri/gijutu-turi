PORT=8787
HOST=127.0.0.1
GIJUTU_DB_PATH=./data/gijutu-turi.sqlite
# Set all three to use Cloudflare D1 instead of local SQLite.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Optional PostgreSQL mode. Do not set together with the D1 variables.
DATABASE_URL=
VITE_BACKEND_URL=
VITE_PUBLIC_ORIGIN=
FRONTEND_ORIGIN=
