{
  "name": "gijutu-turi-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:server": "node --import tsx src/index.ts",
    "dev:server:watch": "tsx watch src/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 8788",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:ocean": "node --import tsx scripts/verify-ocean.ts",
    "test:fish": "node --import tsx scripts/verify-go-fish.ts",
    "test:whale": "node --import tsx scripts/verify-docker-whale.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.0"
  }
}
