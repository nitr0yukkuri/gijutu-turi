{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gijutu-turi",
  "account_id": "34f16c39b883fe8e21fa3cb45f8ff229",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ocean-ws", "/health", "/ready"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gijutu-turi-collections",
      "database_id": "5083cf81-3dc4-41eb-aedd-210921a351f5",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OCEAN_ROOMS", "class_name": "OceanRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OceanRoom"] }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}

