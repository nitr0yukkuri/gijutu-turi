{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    { "source": "/gofish/", "destination": "/gofish", "permanent": true },
    { "source": "/dockerwhale/", "destination": "/dockerwhale", "permanent": true },
    { "source": "/docker/", "destination": "/docker", "permanent": true },
    { "source": "/cssfish/", "destination": "/cssfish", "permanent": true },
    { "source": "/rustfish/", "destination": "/rustfish", "permanent": true },
    { "source": "/jseel/", "destination": "/jseel", "permanent": true },
    { "source": "/k8sfish/", "destination": "/k8sfish", "permanent": true }
  ],
  "rewrites": [
    { "source": "/gofish", "destination": "/index.html" },
    { "source": "/dockerwhale", "destination": "/index.html" },
    { "source": "/docker", "destination": "/index.html" },
    { "source": "/cssfish", "destination": "/index.html" },
    { "source": "/rustfish", "destination": "/index.html" },
    { "source": "/jseel", "destination": "/index.html" },
    { "source": "/k8sfish", "destination": "/index.html" },
    { "source": "/fish=go", "destination": "/index.html" },
    { "source": "/fish=docker", "destination": "/index.html" },
    { "source": "/fish=css", "destination": "/index.html" },
    { "source": "/fish=cssfish", "destination": "/index.html" },
    { "source": "/fish=k8s", "destination": "/index.html" },
    { "source": "/fish=k8sfish", "destination": "/index.html" },
    { "source": "/fish=rust", "destination": "/index.html" },
    { "source": "/fish=rustfish", "destination": "/index.html" },
    { "source": "/fish=js", "destination": "/index.html" },
    { "source": "/fish=jseel", "destination": "/index.html" },
    { "source": "/fish=jsfish", "destination": "/index.html" }
  ]
}
